# Use a private dotenv file. Never commit keys or user data.
LANTERN_HOST=127.0.0.1
LANTERN_PORT=3210
LANTERN_DATA_DIR=data
# Explicitly selected by the user. The referenced file stays outside this repo.
# LANTERN_NORA_CONFIG_PATH=D:/path/to/nora/.env.local
# Alternative standalone configuration (never silently overrides NORA config):
# LANTERN_API_KEY=
# LANTERN_API_BASE_URL=https://api.openai.com/v1
# LANTERN_MODEL=gpt-6-luna
# LANTERN_REASONING_EFFORT=xhigh
# The local budget ledger starts at $5; change it explicitly in Settings.
# Research uses a separate output limit because xhigh reasoning may exhaust
# NORA's interactive-chat limit before producing a complete result.
LANTERN_RESEARCH_MAX_OUTPUT_TOKENS=8192
# Audio models are separate from the configured reasoning model.
LANTERN_STT_MODEL=gpt-transcribe
LANTERN_TTS_MODEL=gpt-4o-mini-tts
# Optional deployed Fuji registry; no private key is needed or accepted by the app.
# LANTERN_REGISTRY_ADDRESS=
LANTERN_FUJI_RPC_URL=https://api.avax-test.network/ext/bc/C/rpc
